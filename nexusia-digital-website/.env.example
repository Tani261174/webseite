# ---------------------------------------------------------------
# NexusIA Digital – Umgebungsvariablen (Beispiel)
# Kopiere diese Datei nach .env.local (lokal) bzw. hinterlege die
# Werte als Secrets in Cloudflare. NIEMALS echte Werte committen.
# ---------------------------------------------------------------

# Öffentliche Basis-URL (für Sitemap, hreflang, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Administration (nur serverseitig) --------------------------
# Solange diese Werte fehlen, ist /admin komplett gesperrt (404).
ADMIN_USER=
ADMIN_PASSWORD=

# --- PayPal (nur serverseitig) ----------------------------------
# PAYPAL_ENV: "sandbox" oder "live". Ohne Werte bleibt der Checkout deaktiviert.
# Zahlungen erst aktivieren, wenn Backend, AGB und Widerruf geprüft sind.
PAYMENTS_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Geschützte Downloads ---------------------------------------
# Zufälliger, langer Schlüssel (z. B. `openssl rand -hex 32`) zum
# Signieren zeitlich begrenzter Download-Links.
DOWNLOAD_SIGNING_SECRET=

# --- E-Mail-Versand (Kontakt & Newsletter) ----------------------
# Ohne Anbieter werden Formulare geprüft, aber nicht versendet.
EMAIL_PROVIDER_API_KEY=
CONTACT_RECIPIENT=

# Geschützte Vorschau: ganze Website nur mit Passwort (Benutzer: vorschau). Mindestens 10 Zeichen. Leer = öffentlich.
PREVIEW_USER=
PREVIEW_PASSWORD=
