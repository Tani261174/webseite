# ------------------------------------------------------------
# SABOR VENEZOLANO – Umgebungsvariablen
# Kopieren nach .env.local (lokal) bzw. beim Hoster als Secrets hinterlegen.
# Diese Datei NIE mit echten Werten committen.
# ------------------------------------------------------------

# Öffentliche Adresse der Website (für SEO, Sitemap, Links)
SITE_URL=http://localhost:3000

# Speicherort für Datenbank (SQLite) und hochgeladene Bilder.
# Muss auf dem Server dauerhaft (persistent) sein und regelmäßig gesichert werden.
DATA_DIR=./data

# Admin-Zugang
ADMIN_USER=admin
# Passwort-Hash erzeugen mit:  npm run admin:hash
ADMIN_PASSWORD_HASH=

# Zufälliger geheimer Schlüssel (mind. 32 Zeichen), z. B. erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Später: Online-Zahlungen (noch NICHT aktiv) ---
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
